generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model Organization {
  id        String  @id @default(cuid())
  name      String
  shortName String?
  legalName String?
  tradeName String?

  logoUrl         String?
  documentLogoUrl String?
  faviconUrl      String?

  primaryColor   String @default("#6D28D9")
  secondaryColor String @default("#FFFFFF")

  cnpj    String?
  email   String?
  phone   String?
  website String?

  address           String?
  addressNumber     String?
  neighborhood      String?
  cep               String?
  addressComplement String?
  city              String?
  state             String?
  stateCode         String?

  documentHeaderText String?

  users             UserProfile[]
  members           Member[]
  directorates      Directorate[]
  positions         Position[]
  clients           Client[]
  projects          Project[]
  contracts         Contract[]
  documents         Document[]
  documentTemplates DocumentTemplate[]
  certificateAssets CertificateAsset[]
  userInvitations   UserInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id             String   @id
  organizationId String
  role           UserRole @default(USER)
  name           String?
  email          String?
  active         Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([role])
}

model UserInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  tokenHash      String   @unique
  role           UserRole @default(USER)
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  LEAVE
  ALUMNI
  POS_JR
}

enum PositionRole {
  PRESIDENT
  VICE_PRESIDENT
  DIRECTOR
  MANAGER
  MEMBER
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  CANCELED
}

enum DocumentType {
  VOLUNTEER_TERM
  TERMINATION_TERM
  CERTIFICATE
  DECLARATION
  CONTRACT
  PROJECT
  CLIENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  PENDING
  SIGNED
  ISSUED
  ARCHIVED
  CANCELED
}

enum DocumentOrigin {
  GENERATED
  IMPORTED
}

enum TemplateFieldType {
  TEXT
  NUMBER
  DATE
  CPF
  CNPJ
  EMAIL
  PHONE
  ADDRESS
  CURRENCY
  BOOLEAN
}

enum TemplateSourceType {
  DOCX
  PDF
  VISUAL
}

enum TemplateRenderMode {
  DOCX_TEMPLATE
  PDF_OVERLAY
  VISUAL_CERTIFICATE
}

enum TemplateProcessingStatus {
  READY
  NEEDS_REVIEW
  REQUIRES_OCR
  FAILED
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Member {
  id             String @id @default(cuid())
  organizationId String

  fullName String
  email    String?
  cpf      String?
  phone    String?

  course       String?
  registration String?

  nationality   String?
  maritalStatus String?

  rg       String?
  rgIssuer String?

  address       String?
  addressNumber String?
  neighborhood  String?
  cep           String?
  city          String?
  state         String?

  entryDate DateTime?
  exitDate  DateTime?

  status MemberStatus @default(ACTIVE)
  membershipHistory Json @default("[]")

  directorateId String?
  positionId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  directorate  Directorate? @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@index([directorateId])
  @@index([positionId])
}

model Directorate {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  active      Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      Member[]
  positions    Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Position {
  id             String @id @default(cuid())
  organizationId String
  directorateId  String?

  name        String
  description String?

  role PositionRole @default(OTHER)

  active Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  directorate  Directorate? @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  members      Member[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([role])
  @@index([directorateId])
}

model Client {
  id             String @id @default(cuid())
  organizationId String

  name        String
  companyName String?
  cpfCnpj     String?

  email String?
  phone String?

  contactName String?

  address String?
  notes   String?

  active Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  contracts    Contract[]
  documents    Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([cpfCnpj])
}

model Project {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String?

  name        String
  description String?

  startDate DateTime?
  endDate   DateTime?

  status ProjectStatus @default(PLANNING)

  budget Decimal? @db.Decimal(12, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  contracts Contract[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

model Contract {
  id             String @id @default(cuid())
  organizationId String

  clientId  String
  projectId String?

  title       String
  description String?

  contractNumber String?

  value Decimal? @db.Decimal(12, 2)

  startDate DateTime?
  endDate   DateTime?

  status ContractStatus @default(DRAFT)

  signatureDate DateTime?

  notes String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([projectId])
  @@index([contractNumber])
}

model DocumentTemplate {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?

  type DocumentType

  content String

  extractedText String?

  originalFileUrl  String?
  originalFileName String?
  originalMimeType String?
  originalFileSize Int?

  sourceType       TemplateSourceType       @default(DOCX)
  renderMode       TemplateRenderMode       @default(DOCX_TEMPLATE)
  processingStatus TemplateProcessingStatus @default(READY)
  processingVersion Int                      @default(1)
  layoutJson        Json?
  confirmedAt       DateTime?

  active Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fields    DocumentTemplateField[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
}

model DocumentTemplateField {
  id         String @id @default(cuid())
  templateId String

  key   String
  label String

  type TemplateFieldType @default(TEXT)

  mappedPath String?

  detectedValue String?
  context       String?

  required Boolean @default(false)

  confidence Float?
  confirmed  Boolean @default(false)
  page       Int?
  x          Float?
  y          Float?
  width      Float?
  height     Float?
  exampleValue String?

  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId])
}

model CertificateAsset {
  id             String @id @default(cuid())
  organizationId String
  storageRef     String
  mimeType       String
  size           Int
  width          Int
  height         Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Document {
  id             String @id @default(cuid())
  organizationId String

  templateId String?

  memberId   String?
  clientId   String?
  projectId  String?
  contractId String?

  title String
  type  DocumentType

  status DocumentStatus @default(DRAFT)

  origin DocumentOrigin @default(GENERATED)
  documentDate DateTime? @db.Date
  organizationDocument Boolean @default(false)
  importedById String?
  importedAt DateTime?
  importedFileHash String?
  importedFileName String?
  importedMimeType String?
  importedFileSize Int?
  importLinks Json?
  duplicateOfId String?
  duplicateReason String?

  description String?

  content String?

  fileUrl String?

  generatedDocxUrl String?
  generatedPdfUrl  String?
  signedFile      String?
  signedAt        DateTime?

  templateLayoutVersion  Int?
  templateLayoutSnapshot Json?

  issueDate     DateTime?
  signatureDate DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  deliveries DocumentDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, importedFileHash])
  @@index([organizationId, documentDate])

  @@index([organizationId])
  @@index([templateId])
  @@index([memberId])
  @@index([clientId])
  @@index([projectId])
  @@index([contractId])
  @@index([type])
  @@index([status])
}

model DocumentDelivery {
  id         String @id @default(cuid())
  documentId String

  channel DeliveryChannel
  status  DeliveryStatus  @default(PENDING)

  recipient String

  subject String?
  message String?

  sentAt DateTime?

  errorMessage String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([channel])
  @@index([status])
}
